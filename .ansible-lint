---
profile: production

exclude_paths:
  - .github/
  # Personal inventories, not part of the collection. Site banners legitimately
  # carry trailing whitespace, which the yaml rules reject.
  - local/
  # Written to be copied out of the collection, so it references the role by
  # its full name. That cannot resolve when linting from the source tree,
  # where the collection is not installed under ansible_collections/.
  - playbooks/ubuntu2404_example.yml

skip_list:
  # Variables use the collection-wide `exorcism_` prefix rather than a per-role
  # prefix. A policy value set once in inventory then applies to whichever OS
  # role runs on the host, instead of having to be duplicated per OS as new
  # roles are added.
  - var-naming[no-role-prefix]
