# 3.3.1 Configure IPv4 parameters

# 3.3.1.1 Ensure net.ipv4.ip_forward is configured
net.ipv4.ip_forward = {{ exorcism_ipv4_ip_forward }}

# 3.3.1.4, 3.3.1.5 Ensure send_redirects is configured
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.send_redirects = 0

# 3.3.1.6 Ensure net.ipv4.icmp_ignore_bogus_error_responses is configured
net.ipv4.icmp_ignore_bogus_error_responses = 1

# 3.3.1.7 Ensure net.ipv4.icmp_echo_ignore_broadcasts is configured
net.ipv4.icmp_echo_ignore_broadcasts = 1

# 3.3.1.8, 3.3.1.9 Ensure accept_redirects is configured
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0

# 3.3.1.10, 3.3.1.11 Ensure secure_redirects is configured
net.ipv4.conf.all.secure_redirects = 0
net.ipv4.conf.default.secure_redirects = 0

# 3.3.1.12, 3.3.1.13 Ensure rp_filter is configured
net.ipv4.conf.all.rp_filter = {{ exorcism_rp_filter }}
net.ipv4.conf.default.rp_filter = {{ exorcism_rp_filter }}

# 3.3.1.14, 3.3.1.15 Ensure accept_source_route is configured
net.ipv4.conf.all.accept_source_route = 0
net.ipv4.conf.default.accept_source_route = 0

# 3.3.1.16, 3.3.1.17 Ensure log_martians is configured
net.ipv4.conf.all.log_martians = 1
net.ipv4.conf.default.log_martians = 1

# 3.3.1.18 Ensure net.ipv4.tcp_syncookies is configured
net.ipv4.tcp_syncookies = 1

# 3.3.2 Configure IPv6 parameters

# 3.3.2.1 Ensure net.ipv6.conf.all.forwarding is configured
net.ipv6.conf.all.forwarding = {{ exorcism_ipv6_forwarding }}

# 3.3.2.3, 3.3.2.4 Ensure accept_redirects is configured
net.ipv6.conf.all.accept_redirects = 0
net.ipv6.conf.default.accept_redirects = 0

# 3.3.2.5, 3.3.2.6 Ensure accept_source_route is configured
net.ipv6.conf.all.accept_source_route = 0
net.ipv6.conf.default.accept_source_route = 0

# 3.3.2.7, 3.3.2.8 Ensure accept_ra is configured
net.ipv6.conf.all.accept_ra = {{ exorcism_ipv6_accept_ra }}
net.ipv6.conf.default.accept_ra = {{ exorcism_ipv6_accept_ra }}
