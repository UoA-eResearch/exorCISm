#!/bin/sh
# 1.4.1 Ensure bootloader password is set
#
# Written by exorCISm. The password guards editing a boot entry and the GRUB
# command line, never booting: every Linux entry is marked --unrestricted.
# grub-mkconfig runs this on every update-grub, so it checks again each time,
# and leaves the password out with a warning if it could stop an unattended
# boot. That is when 10_linux no longer marks its entries --unrestricted, as
# after grub-common replaces it, or when GRUB_DEFAULT points into a submenu,
# which the password would lock.
if ! grep -Eq '^CLASS="[^"]*--unrestricted"' /etc/grub.d/10_linux; then
  echo "exorCISm: 10_linux does not mark boot entries --unrestricted, so the GRUB password is left out" >&2
  exit 0
fi
case "${GRUB_DEFAULT}" in
  *'>'*)
    echo "exorCISm: GRUB_DEFAULT points into a submenu, so the GRUB password is left out" >&2
    exit 0
    ;;
esac
cat <<'EOF'
set superusers="{{ exorcism_grub_superuser }}"
password_pbkdf2 {{ exorcism_grub_superuser }} {{ exorcism_grub_password_hash }}
EOF
